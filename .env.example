# Bắt buộc khi chạy production (server, Docker): chuỗi ngẫu nhiên >= 32 ký tự,
# dùng để ký phiên đăng nhập và mã hoá token tích hợp. Chạy `npm run dev` trên máy cá nhân
# thì có thể bỏ trống: tool tự tạo và lưu ở .data/app-secret.txt.
# Tạo bằng: openssl rand -base64 48
# Đổi giá trị này sẽ làm mất toàn bộ token đã lưu (phải nhập lại ở màn Kết nối).
APP_SECRET=

# Tuỳ chọn: Postgres cho môi trường server. Bỏ trống thì dùng PGlite lưu ở ./.data/pglite
# DATABASE_URL=postgres://qa:qa@localhost:5432/qa_flow_hub

# URL truy cập tool. Bắt đầu bằng https:// thì cookie đăng nhập được đặt cờ Secure.
APP_URL=http://localhost:3000

# Chỉ dùng với docker-compose.yml: mật khẩu Postgres của server.
# POSTGRES_PASSWORD=
